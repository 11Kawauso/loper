rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    /* 投稿の画像・添付ファイル：誰でも閲覧できる。
       アップロード・削除は、パスに含まれるUIDが本人のものである場合のみ許可。
       1ファイルあたり20MBまで。 */
    match /posts/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
