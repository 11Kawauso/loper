rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* 投稿：誰でも閲覧できる。
       作成は本人のUIDで、更新・削除は投稿者本人のみ。
       ただし「ピン止め（pinnedBy）」だけは、ログイン中の誰でも
       自分自身のUIDの追加・削除のみ許可する（お気に入り機能のため）。 */
    match /posts/{postId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && isValidPost()
        // 投稿日時はサーバー側の時刻に固定する。
        // クライアントが未来の日時を指定して一覧の先頭に居座るのを防ぐ。
        && request.resource.data.createdAt == request.time
        && request.resource.data.pinnedBy.size() == 0
        && request.resource.data.closed == false;

      allow update: if (isOwner() && isValidPost() && isValidOwnerUpdate())
        || isValidPinToggle();

      allow delete: if isOwner();

      function isOwner() {
        return request.auth != null && resource.data.authorUid == request.auth.uid;
      }

      /* 保存される投稿の各項目が、画面の入力制限と同じ範囲に収まっているか検証する。
         クライアントを改造して巨大なデータや不正な値を送られるのを防ぐ。 */
      function isValidPost() {
        let d = request.resource.data;
        return d.authorUid is string
          && d.title is string && d.title.size() > 0 && d.title.size() <= 30
          && d.description is string && d.description.size() <= 500
          && d.category in ['game', 'app', 'site', 'video']
          && d.contact is string && d.contact.size() <= 100
          // 連絡先は必須。ただし必須化より前に作られた投稿があるため、
          // すでに保存されている値をそのまま持ち回る更新は通す
          && (d.contact.size() > 0
              || (resource != null && d.contact == resource.data.contact))
          // 選択できるタグは100種類。自由記入分も考慮して余裕をもたせている
          && d.tags is list && d.tags.size() <= 150
          && d.images is list && d.images.size() <= 4
          // 募集する役割。あとから追加した項目のため、持っていない投稿も許容する。
          // 中身（名前・人数）はルール側では1件ずつ検証できないので、
          // 読み込み時に normalizeRoles() でそろえている
          && (!('roles' in d) || (d.roles is list && d.roles.size() <= 6))
          && d.files is list && d.files.size() <= 4
          // 並び替え用に保存している期限の日時（後から追加した項目）
          && (!('deadlineAt' in d) || d.deadlineAt is timestamp)
          && d.deadlineDays is number && d.deadlineDays >= 1
          // 上限を365日から下げたため、それ以前に作られた投稿がある。
          // すでに保存されている値をそのまま持ち回る更新は通し、
          // 古い投稿を編集も締め切りもできなくなるのを防ぐ
          && (d.deadlineDays <= 90
              || (resource != null && d.deadlineDays == resource.data.deadlineDays))
          && d.authorName is string && d.authorName.size() <= 20
          && d.authorAvatarUrl is string && d.authorAvatarUrl.size() <= 400000
          && d.pinnedBy is list
          && d.closed is bool
          // editedは後から追加した項目のため、まだ持っていない既存の投稿も許容する
          && (!('edited' in d) || d.edited is bool);
      }

      /* 投稿者本人による更新でも、投稿の所有権（authorUid）は書き換えさせない。
         authorName・authorAvatarUrlは、プロフィール変更を過去の投稿へ同期できるよう
         本人による更新を許可する（値の妥当性はisValidPost()側でチェック済み）。
         投稿日時は「変更しない」か「募集期限の変更で現在時刻に更新する」のみ許可。 */
      function isValidOwnerUpdate() {
        let d = request.resource.data;
        let p = resource.data;
        return d.authorUid == p.authorUid
          && d.pinnedBy == p.pinnedBy
          && (d.createdAt == p.createdAt || d.createdAt == request.time);
      }

      function isValidPinToggle() {
        let oldPinned = resource.data.pinnedBy;
        let newPinned = request.resource.data.pinnedBy;
        let onlyPinnedByChanged = request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinnedBy']);
        let isAdding = newPinned.size() == oldPinned.size() + 1
          && newPinned.hasAll(oldPinned)
          && newPinned.hasOnly(oldPinned.concat([request.auth.uid]));
        let isRemoving = oldPinned.size() == newPinned.size() + 1
          && oldPinned.hasAll(newPinned)
          && oldPinned.hasOnly(newPinned.concat([request.auth.uid]));
        return request.auth != null && onlyPinnedByChanged && (isAdding || isRemoving);
      }
    }

    /* ユーザープロフィール：本人のみ読み書きできる。
       メールアドレスなどの個人情報を含むため、公開してはいけない。
       投稿一覧に表示する名前・アイコンは投稿(posts)側に複製して保存しており、
       他人のユーザードキュメントを読む必要はない。 */
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    /* 公開プロフィール：他のユーザーが「投稿者のプロフィール」を見るための、
       usersのうち公開してよい項目（名前・アイコン・自己紹介・連絡先・リンク）だけを
       複製したコレクション。メールアドレスなどはここには含めない。
       書き込みは本人のみ、閲覧は誰でも可能。 */
    match /publicProfiles/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.size() <= 400000
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 1000
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 50
        && request.resource.data.links is list && request.resource.data.links.size() <= 10
        // できる役割（あとから追加した項目のため、持っていないプロフィールも許容する）
        && (!('roles' in request.resource.data) || (
             request.resource.data.roles is list && request.resource.data.roles.size() <= 5
           ))
        // GitHub連携（未連携・非表示のときはnull）。中身はクライアントが
        // GitHubの公開APIから取ってきたものなので、形と大きさだけ確認する
        && (!('github' in request.resource.data) || request.resource.data.github == null || (
             request.resource.data.github is map
             && request.resource.data.github.keys().hasOnly(['login', 'languages', 'repos', 'fetchedAt'])
             && request.resource.data.github.login is string
             && request.resource.data.github.login.size() <= 39
             && request.resource.data.github.languages is list
             && request.resource.data.github.languages.size() <= 5
             && request.resource.data.github.repos is list
             && request.resource.data.github.repos.size() <= 3
           ));
      // アカウント削除時に本人が自分のデータを消せるようにする
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    /* 通報：ログインユーザーが自分のUIDで作成のみ可能。閲覧・更新・削除は
       クライアントから行わない（Firebaseコンソールから運営が確認する）。
       投稿の通報とユーザーの通報の両方をここに入れる。 */
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
